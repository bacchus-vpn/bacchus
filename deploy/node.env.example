# Copy to /etc/bacchus/node.env on the node box and fill in real values.
# NEVER commit the real file — only this .example is tracked.
ADVERTISE=YOUR_VPS_PUBLIC_IP:20000
# COUNTRY tags this exit in the client's -list and -geo filter. Use a UNIQUE tag
# per exit — two exits both tagged NL make selection meaningless.
COUNTRY=NL
# Coordinator pool (issue #6): one or more UDP host:port endpoints,
# comma-separated. An exit/relay registers with every member. Example for a
# pool: COORDINATORS=host1:8080,host2:8080
COORDINATORS=YOUR_COORDINATOR_HOST:8080
STUN=stun:YOUR_COORDINATOR_HOST:3478
TURN=turn:YOUR_COORDINATOR_HOST:3478
TURN_USER=bacchus
TURN_PASS=CHANGE_ME
# EXIT_KEY is this exit's persistent X25519 identity — its node id IS its public
# key. Generate ONCE per exit and keep it:  openssl rand -hex 32
# A stable key keeps the exit's id constant across restarts, so clients can pin
# it (-exit-id) and the learned-path store stays valid. Empty = a fresh id each
# start.
EXIT_KEY=
