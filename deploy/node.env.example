# Copy to /etc/bacchus/node.env on the node box and fill in real values.
# NEVER commit the real file — only this .example is tracked.
ADVERTISE=YOUR_VPS_PUBLIC_IP:20000
# COUNTRY tags this exit in the client's -list and -geo filter. Use a UNIQUE tag
# per exit — two exits both tagged NL make selection meaningless.
COUNTRY=NL
# Coordinator pool (issue #6): one or more UDP host:port endpoints,
# comma-separated. An exit/relay registers with every member. Example for a
# pool: COORDINATORS=host1:8080,host2:8080
COORDINATORS=YOUR_COORDINATOR_HOST:8080
STUN=stun:YOUR_COORDINATOR_HOST:3478
TURN=turn:YOUR_COORDINATOR_HOST:3478
TURN_USER=bacchus
TURN_PASS=CHANGE_ME
# EXIT_KEY is this exit's persistent X25519 identity — its node id IS its public
# key. Generate ONCE per exit and keep it:  openssl rand -hex 32
# A stable key keeps the exit's id constant across restarts, so clients can pin
# it (-exit-id) and the learned-path store stays valid. Empty = a fresh id each
# start.
#
# ONE COPY PER NODE, AND THIS FILE IS IT (issue #227). A node's key is both a
# secret and an identity, so a second copy on the same box is a second private key
# with none of the attention the live one gets: it is not rotated when the live one
# is, not removed when the node is decommissioned, and not in any inventory. The
# way it happens is ordinary — a node.env.save, a .bak, a copy taken before an
# edit — and the way it bites is ordinary too: a .save is a file whose NAME says
# restore me, and a restore or a widened EnvironmentFile= glob reinstates an
# identity the signed directory does not name. The node then goes quietly
# unreachable as a hop rather than failing loudly.
#
# So: edit this file in place, and if you want the identity to survive a rebuild,
# put the backup somewhere that is not this machine. Before deleting a second copy
# you find, compare the two by HASH rather than by printing either — if they
# differ, the other one is a PREVIOUS identity and may still appear in an old
# signed directory or someone's cached snapshot, which is worth knowing before it
# is destroyed:
#
#   grep -hs '^EXIT_KEY=' /etc/bacchus/node.env      | sha256sum
#   grep -hs '^EXIT_KEY=' /etc/bacchus/node.env.save | sha256sum
EXIT_KEY=
