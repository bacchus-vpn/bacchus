# Copy to /etc/bacchus/coordinator.env on the coordinator box and fill in real
# values. NEVER commit the real file — only this .example is tracked.
#
# ADVERTISE is the public host:port clients dial for signaling — required
# whenever -addr binds a wildcard (":8080"), which is the default.
ADVERTISE=YOUR_VPS_PUBLIC_IP:8080

# TURN_PUBLIC_IP is the VPS public IP peers are told to use for relayed
# traffic. TURN_PASS must match across the coordinator and every node/client;
# TURN_USER only needs to match if you change it from the default "bacchus".
TURN_PUBLIC_IP=YOUR_VPS_PUBLIC_IP
TURN_USER=bacchus
TURN_PASS=CHANGE_ME
