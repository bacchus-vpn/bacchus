# Host list for deploy/bacchus-pin.sh (issue #205, ADR-0064).
#
# Copy to deploy/testbed.env and fill in. That path is GITIGNORED (`*.env`, with
# `!*.env.example` re-including this template), which is the whole arrangement: real
# addresses live in the operator's own checkout and never enter this repository.
# Every value below is a placeholder — `.invalid` is reserved by RFC 2606 and resolves
# nowhere, so a copy of this file that somebody forgot to edit fails loudly at the first
# connection instead of reaching a stranger's box.
#
# This file is sourced by /bin/sh. It is a host list, not a secret store: no passwords,
# no keys. Authentication is whatever your ssh configuration already does.

# The coordinator box: an ssh target, and the unit name if it is not the default.
COORDINATOR_TARGET=admin@coordinator.example.invalid
COORDINATOR_UNIT=bacchus-coordinator

# The coordinator's SIGNALING address (its -addr, default port 8080) as reachable from
# the machine running the pin — this is what cmd/coordinator-probe probes, and it is
# NOT -turn-addr. The TURN port answers a Binding Request identically on every build
# ever shipped, so pointing the probe there returns a pass against a coordinator of any
# age. Leave it empty only with --no-verify, and read what that costs.
COORDINATOR_SIGNALING=coordinator.example.invalid:8080

# Every node box, space separated, each SSH_TARGET=SYSTEMD_UNIT. `=` rather than `:`
# because an ssh target can be an IPv6 literal. The unit defaults to bacchus-exit.
# A relay runs the same bacchus-node binary under a different unit with a different
# -role, which is why the unit is named per host rather than derived.
NODE_TARGETS="admin@exit-a.example.invalid=bacchus-exit admin@relay-b.example.invalid=bacchus-relay"

# A live unit name whose template this repository does not ship under that name
# (issue #248). The role a node runs is a flag, so a box whose unit is called
# bacchus-node or bacchus-relay is usually running what deploy/bacchus-exit.service
# describes. Without a mapping the pin cannot compare that box AT ALL — and it now says
# so and counts it, rather than skipping it at the volume of a pass. Space separated,
# UNIT=TEMPLATE_FILENAME, and only for units whose names differ from their template.
UNIT_TEMPLATES="bacchus-relay=bacchus-exit.service"

# The credential gates this deployment ENFORCES, space or comma separated (issue #249).
# Empty — the state the testbed is in today — means the pin reports the coordinator's
# gate posture and judges nothing. Naming a gate here means a pin that finds it off
# FAILS the run, which is the point: every gate fails OPEN when unset, so a fleet with
# all of them off passes every other check and refuses nothing anywhere, and a test that
# expects a refusal then passes without one.
#
# Gates: admission device revocation-lists signed-revocations policy account-service
# What to put in the unit to turn each on: deploy/coordinator-gates.env.example.
# `account-service` cannot be read from a journal yet (issue #260) and declaring it
# exits 4 rather than 0 — do not declare it until that lands.
COORDINATOR_GATES=""

# Where the binaries live on the boxes. Matches the units' ExecStart.
BIN_DIR=/usr/local/bin

# What the boxes run. Both binaries are cross-built from one checkout for this pair.
TARGET_GOOS=linux
TARGET_GOARCH=amd64
