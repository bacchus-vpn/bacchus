# Host list for deploy/bacchus-pin.sh (issue #205, ADR-0064).
#
# Copy to deploy/testbed.env and fill in. That path is GITIGNORED (`*.env`, with
# `!*.env.example` re-including this template), which is the whole arrangement: real
# addresses live in the operator's own checkout and never enter this repository.
# Every value below is a placeholder — `.invalid` is reserved by RFC 2606 and resolves
# nowhere, so a copy of this file that somebody forgot to edit fails loudly at the first
# connection instead of reaching a stranger's box.
#
# This file is sourced by /bin/sh. It is a host list, not a secret store: no passwords,
# no keys. Authentication is whatever your ssh configuration already does.

# The coordinator POOL (issue #250). Space separated, each SSH_TARGET=SYSTEMD_UNIT,
# exactly like NODE_TARGETS below — `=` rather than `:` because an ssh target can be an
# IPv6 literal. The unit defaults to bacchus-coordinator. One entry is a pool of one and
# is the ordinary case today.
#
# There is NO coordinator-to-coordinator replication: a node registers with every member
# it was given, and that broadcast is the mechanism rather than a belt-and-braces. So
# every check the pin makes runs once per member and is reported per member — a node
# registered with one and missing from another is a real finding, and any total would
# erase it.
#
# The older singular pair — COORDINATOR_TARGET plus COORDINATOR_UNIT — still works and is
# read as a pool of one. Setting both spellings is refused rather than resolved.
COORDINATOR_TARGETS="admin@coordinator-a.example.invalid=bacchus-coordinator admin@coordinator-b.example.invalid=bacchus-coordinator"

# Each member's SIGNALING address (its -addr, default port 8080) as reachable from the
# machine running the pin, IN THE SAME ORDER as COORDINATOR_TARGETS. This is what
# cmd/coordinator-probe probes, and it is NOT -turn-addr. The TURN port answers a Binding
# Request identically on every build ever shipped, so pointing the probe there returns a
# pass against a coordinator of any age.
#
# One address per member, and the pin refuses a count that does not match: a member
# nothing probes is a member the run cannot say anything about, and it would be reported
# at the volume of one that passed (issue #248). Leave it empty only with --no-verify, and
# read what that costs.
COORDINATOR_SIGNALING="coordinator-a.example.invalid:8080 coordinator-b.example.invalid:8080"

# Every node box, space separated, each SSH_TARGET=SYSTEMD_UNIT. `=` rather than `:`
# because an ssh target can be an IPv6 literal. The unit defaults to bacchus-exit.
# A relay runs the same bacchus-node binary under a different unit with a different
# -role, which is why the unit is named per host rather than derived.
NODE_TARGETS="admin@exit-a.example.invalid=bacchus-exit admin@relay-b.example.invalid=bacchus-relay"

# A live unit name whose template this repository does not ship under that name
# (issue #248). The role a node runs is a flag, so a box whose unit is called
# bacchus-node or bacchus-relay is usually running what deploy/bacchus-exit.service
# describes. Without a mapping the pin cannot compare that box AT ALL — and it now says
# so and counts it, rather than skipping it at the volume of a pass. Space separated,
# UNIT=TEMPLATE_FILENAME, and only for units whose names differ from their template.
UNIT_TEMPLATES="bacchus-relay=bacchus-exit.service"

# The credential gates this deployment ENFORCES, space or comma separated (issue #249).
# Empty — the state the testbed is in today — means the pin reports each coordinator's
# gate posture and judges nothing. Naming a gate here means a pin that finds it off on ANY
# pool member FAILS the run, which is the point: every gate fails OPEN when unset, so a
# fleet with all of them off passes every other check and refuses nothing anywhere, and a
# test that expects a refusal then passes without one.
#
# Every member is held to the whole list, and that is the pool's sharpest edge: a client
# rotates freely and there is no replication, so one member started without a gate is a
# way AROUND that gate rather than a partial deployment of it.
#
# Gates: admission device revocation-lists signed-revocations policy account-service
# What to put in the unit to turn each on: deploy/coordinator-gates.env.example.
# `account-service` cannot be read from a journal yet (issue #260) and declaring it
# exits 4 rather than 0 — do not declare it until that lands.
COORDINATOR_GATES=""

# Where the binaries live on the boxes. Matches the units' ExecStart.
BIN_DIR=/usr/local/bin

# Where the two rollback artifacts go (issue #234, ADR-0074). deploy/install.sh uses these
# same two paths, and deploy/bacchus-update-rollback@.service names the first one in its
# ExecStart — so changing LIBEXEC_DIR here without changing that template gives you a unit
# pointing at a handler that is not there. Almost nobody should touch either.
#
# What the pin delivers to them is a fixed list inside bacchus-pin.sh and is deliberately
# NOT configurable: an operator who could add an entry could add
# bacchus-coordinator.service, and the whole of ADR-0064 §7 is that nobody may.
LIBEXEC_DIR=/usr/local/lib/bacchus
UNIT_DIR=/etc/systemd/system

# What the boxes run. Both binaries are cross-built from one checkout for this pair.
TARGET_GOOS=linux
TARGET_GOARCH=amd64
